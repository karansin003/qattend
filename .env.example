
QUMS_QID=
QUMS_PASSWORD=
QUMS_LOGIN_URL=https://qums.quantumuniversity.edu.in/
QUMS_DASHBOARD_URL=https://qums.quantumuniversity.edu.in/Web_StudentAcademic/Cyborg_S_Dashboard
QUMS_TIMETABLE_URL=https://qums.quantumuniversity.edu.in/Web_StudentAcademic/Cyborg_StudentTimeTable?id=Time%20Table


ATTENDANCE_TOTAL_CLASSES=40

PORT=3000


APP_BASE_URL=http://localhost:3000

WATCH_INTERVAL_MINUTES=2

MONTH_REGISTER_INTERVAL_MINUTES=5

# Historical (backdated) month monitoring — TIERED so the portal is never hammered
# while delayed teacher updates are still detected.
#   Tier 1: CURRENT month      -> every cycle (MONTH_REGISTER_INTERVAL_MINUTES)
#   Tier 2: PREVIOUS month     -> every MONTH_REGISTER_RECENT_EVERY_CYCLES cycles
#   Tier 3: older months 2..N  -> every MONTH_REGISTER_OLDER_EVERY_HOURS hours
# MONTH_REGISTER_MONTHS_BACK = TOTAL previous months kept under monitoring.
# Default 5 covers the whole running semester (Aug..Dec for an Aug start).
# 0 = current month only (minimum portal load).
MONTH_REGISTER_MONTHS_BACK=5
MONTH_REGISTER_RECENT_EVERY_CYCLES=2
MONTH_REGISTER_OLDER_EVERY_HOURS=6

# Tier-clock state file (only the scan cadence lives here — per-user attendance
# state is always in the database).
# MONTH_REGISTER_TIER_STATE_FILE=

# New-assignment check interval (minutes) + 7:00 PM IST deadline reminder
# (the reminder cron itself is fixed at "0 19 * * *" Asia/Kolkata).
ASSIGNMENT_INTERVAL_MINUTES=30

# Optional REAL support address for the public Contact page. Left empty the
# page shows an explicit "not configured" note instead of an invented address.
# CONTACT_EMAIL=support@example.com

# Telegram bot (BotFather token). NEVER commit the real token — .env.example me placeholder rakho.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=qums_attendance_bot

# Polling sirf EK instance se chalti hai. Baaki instances/workers (jahan dashboard
# nahi chahiye) me `TELEGRAM_POLLING=off` set karo -> wo sirf sends karenge, koi
# getUpdates nahi (duplicate /start replies aur 409 conflicts nahi).
# TELEGRAM_POLLING=off
# Per-machine poller pid lock (default: data/telegram-polling.lock).
# TELEGRAM_POLLING_LOCK=

# Morning schedule (default 8:30 AM IST). Late/catch-up runs is hour ke baad skip.
# MORNING_CRON=30 8 * * *
# MORNING_LATE_SKIP_HOUR=11
# 08:15 IST cache pre-warm (8:30 wala message fast rakhne ke liye). Off karne ke liye: off
# MORNING_PREWARM_CRON=15 8 * * *

ENCRYPTION_KEY=
SESSION_SECRET=
RESEND_API_KEY=
DATABASE_URL=
ADMIN_EMAILS=

# Firebase Authentication — PUBLIC project identifier only (NOT a secret).
# Used by the server to verify Firebase ID tokens (iss/aud checks).
FIREBASE_PROJECT_ID=qums-forgot-password-test


